{
  "name": "deckwarden",
  "version": "0.1.0",
  "description": "Bitwarden Cloud vault in Steam Deck Game Mode via official bw CLI",
  "type": "module",
  "scripts": {
    "fetch-bw": "bash scripts/fetch-bw.sh",
    "build": "bash scripts/fetch-bw.sh && rollup -c",
    "watch": "rollup -c -w",
    "check": "python3 tests/check.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neronmoon/DeckWarden.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "bitwarden",
    "bw"
  ],
  "author": "neronmoon",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/neronmoon/DeckWarden/issues"
  },
  "homepage": "https://github.com/neronmoon/DeckWarden#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
