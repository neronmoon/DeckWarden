#!/usr/bin/env bash
set -euo pipefail

PIN="${RBW_PIN:-}"
if [ -z "$PIN" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -r "$XDG_RUNTIME_DIR/deckwarden/pin" ]; then
  PIN=$(cat "$XDG_RUNTIME_DIR/deckwarden/pin")
fi

if [ -z "$PIN" ]; then
  for candidate in pinentry pinentry-curses pinentry-tty; do
    if command -v "$candidate" >/dev/null 2>&1; then
      exec "$candidate" "$@"
    fi
  done
  echo "ERR 1 no pinentry" >&2
  exit 1
fi

echo "OK Pleased to meet you"
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    GETPIN*)
      printf 'D %s\n' "$PIN"
      echo "OK"
      ;;
    BYE*)
      echo "OK closing connection"
      exit 0
      ;;
    *)
      echo "OK"
      ;;
  esac
done
